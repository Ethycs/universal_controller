[Unit]
Description=UC Grok OpenAI-compatible proxy (loopback)
Wants=uc-service.service
After=uc-service.service network-online.target

[Service]
Type=simple
WorkingDirectory=%h/universal_controller
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
Environment=UC_AUTO_BOOTSTRAP=0
Environment=UC_GROK_SERVICE_URL=http://127.0.0.1:4010
ExecStart=%h/.pixi/bin/pixi run --frozen python -m uc_browser.grok_proxy --config %h/universal_controller/grok-proxy.config.yaml --port 4000
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
