@charset "utf-8";

body { color: rgb(80, 81, 83); font-family: Helvetica, Arial, sans-serif; f=
ont-size: 12px; text-align: center; background-color: rgb(255, 255, 255); }

a { text-decoration: none; color: rgb(255, 85, 0); }

a:hover { text-decoration: underline; color: rgb(80, 81, 83); }

input, select, textarea, button { color: black; font-family: Arial, Helveti=
ca, sans-serif; font-size: 1em; }

code, input[type=3D"text"], input[type=3D"number"], input[type=3D"password"=
], input[type=3D"email"], select, textarea { background-color: rgb(185, 217=
, 235); border: 1px solid rgb(95, 96, 99); border-radius: 3px; }

select { max-width: 50em; }

input[type=3D"button"], input[type=3D"reset"], input[type=3D"submit"], butt=
on, a.button { background-color: rgb(255, 85, 0); border: 1px solid rgb(80,=
 81, 83); color: white; border-radius: 7px; padding: 3px 6px; }

a.button { text-decoration: none; padding: 3px 6px; cursor: pointer; }

input[disabled], select[disabled], textarea[disabled], button[disabled=3D"d=
isabled"] { background-color: rgb(255, 255, 255); border-color: rgb(204, 20=
4, 204); color: rgb(204, 204, 204); }

hr { height: 1px; border: 0px; color: rgb(194, 191, 191); background-color:=
 rgb(194, 191, 191); }

code { color: black; border: 1px outset rgb(0, 0, 0); padding: 0.5em; font-=
family: "Courier New", Courier, monospace; }

code.block { display: block; margin: 0.5em 0px; }

p { margin: 1em 0px; }

pre { padding: 1em; background-color: rgb(238, 238, 238); border: 0.1em das=
hed rgb(80, 81, 83); font-size: 1em; }

img, a img { border-width: 0px; }

div#container, .container { width: 60em; margin: 0px auto; text-align: left=
; }

table { background-color: transparent; border-collapse: collapse; }

td, th, form.tableless label { margin: 0.1em; padding: 0.1em; }

form.tableless label, th { text-align: right; vertical-align: top; font-wei=
ght: 800; min-width: 30px; }

form.tableless label a, th a { color: rgb(80, 81, 83); }

form.tableless br { clear: left; margin-bottom: 0.7em; }

thead tr th, tr.header th { text-align: center; vertical-align: bottom; min=
-width: 30px; }

tr.header th div.expander { text-align: left; float: left; }

.note { font-size: 0.8em; color: rgb(170, 170, 170); }

.editViewNote { margin-top: 0.25em; margin-left: 1.5em; color: rgb(111, 112=
, 114); }

.editViewNote.last { margin-bottom: 1em; }

tr.even > td { background-color: rgb(240, 240, 240); }

tr.odd > td { background-color: rgb(248, 248, 248); }

tr.userdisabled, span.userdisabled { background-color: rgb(238, 170, 170); =
}

#header a { font-weight: bold; text-decoration: none; }

#footer { padding: 0.5em 1em; color: rgb(80, 81, 83); font-size: 0.9em; }

#footer.admin { text-align: center; }

#footer a { color: rgb(80, 81, 83); }

.occlude { background-color: rgb(185, 217, 235); border: 0.1em solid rgb(19=
4, 191, 191); z-index: 100; }

.boxTitle { font-size: 1em; color: rgb(80, 81, 83); text-decoration: none; =
font-weight: bold; }

.error { color: red !important; font-weight: bold; }

h3.error ul { text-align: left; }

.warning { color: goldenrod !important; font-weight: bold; }

