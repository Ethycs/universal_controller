@charset "utf-8";

@media only screen and (max-device-width: 979px) {
  * { box-sizing: border-box; }
  #header { padding: 10px; }
  #header .pageTitle { font-size: 22px; }
  #header .logo-container { height: 44px; float: left; }
  #logo { width: 80%; height: 80%; }
  div#container { width: 100%; margin: 0px; }
  .contentBox { margin: 0px 0px 8px; padding: 24px 12px 12px; border: 2px s=
olid rgb(194, 191, 191); }
  .contentBox h1 { font-size: 16px; }
  .contentBox h2 { font-size: 14px; }
  .contentBox h3 { font-size: 12px; }
  .contentBox h1, .contentBox h2, .contentBox h3 { margin: -24px -12px 6px;=
 padding: 4px 6px; }
  form.tableless label { padding: 3px 0px; text-align: left; width: auto; c=
lear: right; }
  form.tableless span { margin-bottom: 6px; display: block; clear: both; }
  form.tableless input[type=3D"text"], form.tableless textarea { width: 100=
%; max-width: 524px; }
  input, select { height: 24px; }
  input, select, textarea, button { font-size: inherit; }
  .repLink { font-size: 14px; }
  #footer { padding: 6px; text-align: center; }
  #powered-by { margin: 6px; }
  input[type=3D"button"], input[type=3D"reset"], input[type=3D"submit"], bu=
tton { background-color: rgb(255, 85, 0); border: 1px solid rgb(95, 96, 98)=
; color: white; border-radius: 7px; display: inline-block; padding: 4px 12p=
x; margin-bottom: 0px; font-size: 14px; line-height: 14px; text-align: cent=
er; vertical-align: middle; cursor: pointer; background-repeat: repeat-x; b=
ackground-image: linear-gradient(rgb(255, 122, 66) 0%, rgb(255, 85, 0) 50%,=
 rgb(230, 76, 0) 100%); }
  input[type=3D"button"][disabled], input[type=3D"reset"][disabled], input[=
type=3D"submit"][disabled], button[disabled] { color: rgb(204, 204, 204); b=
order-color: rgb(204, 204, 204); background-color: rgb(255, 255, 255); back=
ground-image: linear-gradient(rgb(255, 255, 255) 0%, rgb(255, 255, 255) 100=
%); }
}

@media only screen and (max-width: 767px) and (orientation: portrait) {
  #header .pageTitle { text-align: left; }
  #header .lang-selection { text-align: left; }
}

@media handheld {
  #logo { width: 100px; height: 20px; text-align: right; }
  .sectionTitle { text-align: left; }
  .sectionTitle span { float: none; display: inline; }
  form.tableless label, form.tableless span { text-align: left; }
  .accessible { display: none !important; }
}

ul.section-start-buttons { list-style-type: none; }

.session-start-buttons { padding: 0px; margin: 15px 0px; }

.session-start-buttons li { padding: 0px; margin: 0px 0px 16px; }

.session-start-buttons button { font-size: 21px; display: block; padding: 8=
px; margin: 16px auto; width: 160px; }
